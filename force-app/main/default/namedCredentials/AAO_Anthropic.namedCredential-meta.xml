<?xml version="1.0" encoding="UTF-8"?>
<!--
  The callout target. Apex calls callout:AAO_Anthropic/v1/messages and never writes
  api.anthropic.com or the key anywhere.

  Three headers are set here rather than in Apex, deliberately:

    x-api-key         the secret, by merge field. $Credential.Password is the encrypted slot
                      on the external credential's named principal. Apex cannot read it and a log
                      cannot leak it, because substitution happens after Apex is done.
    anthropic-version the API version, pinned. A version this old changing under us is
                      the failure mode a pinned value exists to prevent.
    content-type      constant for every request we make.

  generateAuthorizationHeader is false because Anthropic does not use one. Left true, the
  platform would add an empty Authorization header alongside x-api-key, which is noise at
  best and a 401 at worst.

  allowMergeFieldsInHeader must be true or the x-api-key merge field is sent as its own
  literal text and every call returns 401 authentication_error.

  allowMergeFieldsInBody stays false. Nothing we send should be able to interpolate a
  credential into a request body, and a transcript is attacker-influenced text in the
  general case even though ours are authored.
-->
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>true</allowMergeFieldsInHeader>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
    <label>AAO Anthropic</label>
    <namedCredentialType>SecuredEndpoint</namedCredentialType>
    <namedCredentialParameters>
        <parameterName>Url</parameterName>
        <parameterType>Url</parameterType>
        <parameterValue>https://api.anthropic.com</parameterValue>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <parameterName>AAO_Anthropic</parameterName>
        <parameterType>Authentication</parameterType>
        <externalCredential>AAO_Anthropic</externalCredential>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <parameterName>x-api-key</parameterName>
        <parameterType>HttpHeader</parameterType>
        <parameterValue>{!$Credential.Password}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <parameterName>anthropic-version</parameterName>
        <parameterType>HttpHeader</parameterType>
        <parameterValue>2023-06-01</parameterValue>
        <sequenceNumber>2</sequenceNumber>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <parameterName>content-type</parameterName>
        <parameterType>HttpHeader</parameterType>
        <parameterValue>application/json</parameterValue>
        <sequenceNumber>3</sequenceNumber>
    </namedCredentialParameters>
</NamedCredential>
