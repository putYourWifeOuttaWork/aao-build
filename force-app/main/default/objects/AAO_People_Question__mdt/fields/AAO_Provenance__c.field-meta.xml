<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
<!--
  WHERE THE SHIPPED TEXT CAME FROM, and it is load-bearing rather than decorative.

  Label: captured byte-exact from a queryable ExternalString row, so it can be re-verified
  against the org at authoring time. UI_Capture: transcribed by a human from a wizard modal
  that has no label behind it — Decision Orientation's definitions, the same position Buyer
  Role is in — and therefore CANNOT be re-queried. Marking it stops a later pass from
  "verifying" a UI-captured string against a label table that never held it and declaring a
  phantom mismatch.

  Null is READ AS Label, for the records that predate this field: every one of them was
  captured from a label, so the assumption invents no history. Only the genuinely-different
  records carry an explicit value, the same pattern AAO_EvidenceFamily.orTranscript uses.
  DeveloperControlled: it is ours and ships with the seed.
-->
    <fullName>AAO_Provenance__c</fullName>
    <label>Provenance</label>
    <type>Picklist</type>
    <fieldManageability>DeveloperControlled</fieldManageability>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value><fullName>Label</fullName><default>true</default><label>Label</label></value>
            <value><fullName>UI_Capture</fullName><default>false</default><label>UI Capture</label></value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
