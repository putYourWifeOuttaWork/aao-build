<?xml version="1.0" encoding="UTF-8"?>
<!--
  Requested, deployed, and redundant. Stating that rather than letting a later reader
  discover it.

  A callout made through a Named Credential does not consult Remote Site Settings. The
  Named Credential IS the allow-list entry. This record therefore permits something no
  code in this repo does: a direct HttpRequest to https://api.anthropic.com with a
  hand-set header.

  It is kept because it costs nothing and because its absence is a confusing failure if
  anyone ever debugs by temporarily bypassing the Named Credential. But it should not be
  read as load-bearing, and if the honest inventory of this org is ever taken, this is a
  row that does nothing.
-->
<RemoteSiteSetting xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Redundant alongside the AAO_Anthropic Named Credential, which does not consult remote site settings. Deployed on request.</description>
    <disableProtocolSecurity>false</disableProtocolSecurity>
    <isActive>true</isActive>
    <url>https://api.anthropic.com</url>
</RemoteSiteSetting>
